# ─── Pool platform-admin surface (#85) ───────────────────────────────────────
# Server-only base URLs of the Pool API. NOT NEXT_PUBLIC_* — they must never be
# bundled into client JS. The /admin Next Route Handlers + proxy read them
# server-side and call the API server→server.
#
# POOL_API_BASE_URL is the DEFAULT ENVIRONMENT the dashboard opens on (#112).
# It is not "the" API URL any more — it decides where a fresh session lands.
# Defaults to staging if unset.
POOL_API_BASE_URL="https://api-staging.poolapp.co"

# ─── Environment switcher (#112) ─────────────────────────────────────────────
# The Staging ⇄ Production toggle works with NO extra config: staging and
# production have built-in defaults (api-staging.poolapp.co / api.poolapp.co).
# Set these ONLY to point an environment somewhere else — a review deployment,
# a self-hosted API, a local server. Sessions are per-environment (cookies are
# namespaced `pool_admin_at__staging` / `__production`), so you log into each
# one separately and a token is never reused across them.
# POOL_API_BASE_URL_STAGING="https://api-staging.poolapp.co"
# POOL_API_BASE_URL_PRODUCTION="https://api.poolapp.co"
# Setting this also makes LOCAL appear in the switcher (otherwise hidden).
# POOL_API_BASE_URL_LOCAL="http://localhost:3000"

# ─── Firebase (waitlist + questionnaire storage) ─────────────────────────────
# SERVER-ONLY. The full service-account JSON for the Firebase project, exactly
# as downloaded (one line is fine). The waitlist Route Handlers read Firestore
# with the Admin SDK; nothing in the browser talks to Firebase, so there are no
# NEXT_PUBLIC_FIREBASE_* variables any more. Never commit a real value — on
# Vercel it is a Sensitive environment variable. Unset → the waitlist routes
# answer 503 (fail closed).
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Contact form (app/api/contact/route.tsx) ─────────────────────────────────
# ⚠️ REQUIRED. The key used to live as a literal in that file, in a PUBLIC repo,
# from the initial fork commit until it was moved here — so the old one is
# compromised and must be REVOKED in Resend, not just replaced.
RESEND_API_KEY=
# Optional. Defaults to Resend's sandbox sender, which is likely to be filtered.
# Set this to an address on a domain verified in Resend once that exists.
CONTACT_FROM_EMAIL=

# ── Admin map tiles (poolweb#33) ────────────────────────────────────────────
# CloudFront distribution in front of the self-hosted Protomaps archive
# (poolmobile `infra/map-tiles/`). PUBLIC on purpose — the browser fetches the
# basemap directly by HTTP range request, with no tile server in between, and
# the archive is public reference data carrying nothing of ours.
#
# Staging and production point at the SAME distribution, exactly as the mobile
# app does: one copy of the basemap is one thing to refresh.
#
# Unset is a supported state — the Geography tab's map panel says so and the
# city table beside it is unaffected.
NEXT_PUBLIC_MAP_TILES_BASE_URL=https://dqn7ilu6qcm2q.cloudfront.net

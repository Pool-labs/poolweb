# ─── Pool platform-admin surface (#85) ───────────────────────────────────────
# Server-only base URLs of the Pool API. NOT NEXT_PUBLIC_* — they must never be
# bundled into client JS. The /admin Next Route Handlers + proxy read them
# server-side and call the API server→server.
#
# POOL_API_BASE_URL is the DEFAULT ENVIRONMENT the dashboard opens on (#112).
# It is not "the" API URL any more — it decides where a fresh session lands.
# Defaults to staging if unset.
POOL_API_BASE_URL="https://api-staging.poolapp.co"

# ─── Environment switcher (#112) ─────────────────────────────────────────────
# The Staging ⇄ Production toggle works with NO extra config: staging and
# production have built-in defaults (api-staging.poolapp.co / api.poolapp.co).
# Set these ONLY to point an environment somewhere else — a review deployment,
# a self-hosted API, a local server. Sessions are per-environment (cookies are
# namespaced `pool_admin_at__staging` / `__production`), so you log into each
# one separately and a token is never reused across them.
# POOL_API_BASE_URL_STAGING="https://api-staging.poolapp.co"
# POOL_API_BASE_URL_PRODUCTION="https://api.poolapp.co"
# Setting this also makes LOCAL appear in the switcher (otherwise hidden).
# POOL_API_BASE_URL_LOCAL="http://localhost:3000"

# ─── Firebase (marketing site: waitlist + questionnaire, unchanged) ───────────
# Public client config — the marketing pages and the Firestore-backed waitlist
# admin screens still use these. (No longer used for admin auth.)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
